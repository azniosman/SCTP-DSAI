## Data Analysis and Manipulation

### Pandas Best Practices

**Method Chaining for Readability:**
```python
# Preferred: Clear, readable transformation pipeline
result = (df
    .query('age > 25 and status == "active"')
    .assign(
        revenue_per_customer=lambda x: x['total_revenue'] / x['customer_count'],
        growth_rate=lambda x: (x['current'] - x['previous']) / x['previous']
    )
    .groupby(['region', 'category'])
    .agg({
        'revenue': ['sum', 'mean', 'std'],
        'customers': 'count'
    })
    .round(2)
)

# Avoid: Multiple intermediate variables
filtered_df = df[df['age'] > 25]
filtered_df = filtered_df[filtered_df['status'] == 'active']
...
```

**Explicit Indexing:**
```python
# Always use .loc or .iloc for data selection
df.loc[df['revenue'] > 1000, ['customer_id', 'revenue']]  # Label-based
df.iloc[0:10, [0, 2, 3]]  # Position-based

# Avoid: Chained indexing (can cause SettingWithCopyWarning)
# df['revenue']['high'] = True  # DON'T DO THIS
```

**Efficient Data Aggregation:**
```python
# Use groupby with multiple aggregation functions
summary = df.groupby('category').agg({
    'revenue': ['sum', 'mean', 'count'],
    'quantity': 'sum',
    'customer_id': 'nunique'
}).round(2)

# Named aggregations for clearer column names (pandas 0.25+)
summary = df.groupby('category').agg(
    total_revenue=('revenue', 'sum'),
    avg_revenue=('revenue', 'mean'),
    customer_count=('customer_id', 'nunique')
)
```

### Data Validation and Quality Checks

**Initial Data Validation Function:**
```python
from typing import List, Dict
import pandas as pd

def validate_dataframe(
    df: pd.DataFrame,
    required_columns: List[str],
    numeric_columns: List[str] = None,
    date_columns: List[str] = None
) -> Dict[str, any]:
    """
    Comprehensive DataFrame validation.
    
    Args:
        df: DataFrame to validate
        required_columns: Columns that must exist
        numeric_columns: Columns that should be numeric
        date_columns: Columns that should be datetime
        
    Returns:
        Dictionary with validation results and quality metrics
    """
    results = {
        'valid': True,
        'errors': [],
        'warnings': [],
        'metrics': {}
    }
    
    # Check required columns
    missing_cols = set(required_columns) - set(df.columns)
    if missing_cols:
        results['valid'] = False
        results['errors'].append(f"Missing required columns: {missing_cols}")
    
    # Validate data types
    if numeric_columns:
        for col in numeric_columns:
            if col in df.columns and not pd.api.types.is_numeric_dtype(df[col]):
                results['errors'].append(f"Column '{col}' should be numeric")
    
    if date_columns:
        for col in date_columns:
            if col in df.columns and not pd.api.types.is_datetime64_any_dtype(df[col]):
                results['warnings'].append(f"Column '{col}' should be datetime")
    
    # Calculate data quality metrics
    missing_pct = (df.isnull().sum() / len(df) * 100).round(2)
    results['metrics']['missing_data'] = missing_pct[missing_pct > 0].to_dict()
    results['metrics']['duplicate_rows'] = df.duplicated().sum()
    results['metrics']['shape'] = df.shape
    
    return results

# Usage
validation = validate_dataframe(
    df,
    required_columns=['customer_id', 'date', 'revenue'],
    numeric_columns=['revenue', 'quantity'],
    date_columns=['date']
)

if not validation['valid']:
    raise ValueError(f"Validation failed: {validation['errors']}")
```

