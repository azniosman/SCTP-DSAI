### Reusable Plotting Functions
```python
from typing import Optional, Tuple
import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd
import numpy as np

def plot_distribution(
    data: pd.DataFrame,
    column: str,
    title: Optional[str] = None,
    bins: int = 30,
    figsize: Tuple[int, int] = (14, 5),
    color: str = '#2E86AB'
) -> plt.Figure:
    """
    Create standardized distribution plots (histogram + box plot).
    
    Args:
        data: DataFrame containing the data
        column: Column name to plot
        title: Custom title (optional)
        bins: Number of bins for histogram
        figsize: Figure size tuple
        color: Color for plots
        
    Returns:
        Matplotlib figure object
    """
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=figsize)
    
    # Histogram with KDE
    ax1.hist(data[column].dropna(), bins=bins, edgecolor='black', 
             alpha=0.7, color=color, density=True)
    data[column].plot(kind='kde', ax=ax1, color='darkred', linewidth=2)
    ax1.set_xlabel(column.replace('_', ' ').title(), fontweight='bold')
    ax1.set_ylabel('Density', fontweight='bold')
    ax1.set_title(f'{title or column} - Distribution', fontsize=13, fontweight='bold')
    ax1.grid(alpha=0.3)
    
    # Box plot
    sns.boxplot(y=data[column], ax=ax2, color=color, width=0.4)
    ax2.set_ylabel(column.replace('_', ' ').title(), fontweight='bold')
    ax2.set_title(f'{title or column} - Box Plot', fontsize=13, fontweight='bold')
    ax2.grid(alpha=0.3, axis='y')
    
    plt.tight_layout()
    return fig

def plot_time_series(
    data: pd.DataFrame,
    date_column: str,
    value_column: str,
    title: Optional[str] = None,
    figsize: Tuple[int, int] = (14, 6),
    add_trend: bool = True
) -> plt.Figure:
    """
    Create time series plot with optional trend line.
    
    Args:
        data: DataFrame with time series data
        date_column: Name of date column
        value_column: Name of value column
        title: Custom title
        figsize: Figure size tuple
        add_trend: Whether to add trend line
        
    Returns:
        Matplotlib figure object
    """
    fig, ax = plt.subplots(figsize=figsize)
    
    # Plot time series
    ax.plot(data[date_column], data[value_column], 
            linewidth=2, marker='o', markersize=4, label='Actual')
    
    # Add trend line
    if add_trend:
        z = np.polyfit(range(len(data)), data[value_column], 1)
        p = np.poly1d(z)
        ax.plot(data[date_column], p(range(len(data))), 
                "--", linewidth=2, alpha=0.8, label='Trend', color='red')
    
    ax.set_xlabel('Date', fontweight='bold')
    ax.set_ylabel(value_column.replace('_', ' ').title(), fontweight='bold')
    ax.set_title(title or f'{value_column} Over Time', fontsize=14, fontweight='bold')
    ax.legend(loc='best')
    ax.grid(alpha=0.3)
    plt.xticks(rotation=45)
    plt.tight_layout()
    
    return fig
```

