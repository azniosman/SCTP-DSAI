## Performance Optimization

### Memory Optimization
```python
def optimize_dataframe_memory(df: pd.DataFrame) -> pd.DataFrame:
    """
    Reduce DataFrame memory usage by optimizing data types.
    
    Args:
        df: DataFrame to optimize
        
    Returns:
        Optimized DataFrame
    """
    start_mem = df.memory_usage(deep=True).sum() / 1024**2
    print(f"Memory usage before optimization: {start_mem:.2f} MB")
    
    for col in df.columns:
        col_type = df[col].dtype
        
        if col_type != object:
            c_min = df[col].min()
            c_max = df[col].max()
            
            if str(col_type)[:3] == 'int':
                if c_min > np.iinfo(np.int8).min and c_max < np.iinfo(np.int8).max:
                    df[col] = df[col].astype(np.int8)
                elif c_min > np.iinfo(np.int16).min and c_max < np.iinfo(np.int16).max:
                    df[col] = df[col].astype(np.int16)
                elif c_min > np.iinfo(np.int32).min and c_max < np.iinfo(np.int32).max:
                    df[col] = df[col].astype(np.int32)
            else:
                if c_min > np.finfo(np.float16).min and c_max < np.finfo(np.float16).max:
                    df[col] = df[col].astype(np.float32)
        else:
            # Convert to category if cardinality is low
            num_unique_values = len(df[col].unique())
            num_total_values = len(df[col])
            if num_unique_values / num_total_values < 0.5:
                df[col] = df[col].astype('category')
    
    end_mem = df.memory_usage(deep=True).sum() / 1024**2
    print(f"Memory usage after optimization: {end_mem:.2f} MB")
    print(f"Decreased by {100 * (start_mem - end_mem) / start_mem:.1f}%")
    
    return df

# Usage
df = optimize_dataframe_memory(df)
```

### Vectorization Examples
```python
# Bad: Loop-based approach
total = 0
for idx in range(len(df)):
    total += df.loc[idx, 'price'] * df.loc[idx, 'quantity']

# Good: Vectorized operation
total = (df['price'] * df['quantity']).sum()

# Bad: Apply with lambda for simple operations
df['total'] = df.apply(lambda row: row['price'] * row['quantity'], axis=1)

# Good: Direct vectorized operation
df['total'] = df['price'] * df['quantity']

# When apply is appropriate: Complex logic
def calculate_discount(row):
    if row['customer_type'] == 'premium' and row['total'] > 1000:
        return row['total'] * 0.15
    elif row['customer_type'] == 'regular' and row['total'] > 500:
        return row['total'] * 0.10
    return 0

df['discount'] = df.apply(calculate_discount, axis=1)
```

## Error Handling and Data Validation

### Robust Data Loading
```python
from typing import Union
import logging

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def load_data_safely(
    file_path: Union[str, Path],
    file_type: str = 'csv',
    **kwargs
) -> pd.DataFrame:
    """
    Safely load data with comprehensive error handling.
    
    Args:
        file_path: Path to data file
        file_type: Type of file ('csv', 'excel', 'parquet')
        **kwargs: Additional arguments for read function
        
    Returns:
        Loaded DataFrame
        
    Raises:
        FileNotFoundError: If file doesn't exist
        ValueError: If file type is unsupported
    """
    file_path = Path(file_path)
    
    if not file_path.exists():
        logger.error(f"File not found: {file_path}")
        raise FileNotFoundError(f"File not found: {file_path}")
    
    try:
        logger.info(f"Loading {file_type} file: {file_path}")
        
        if file_type == 'csv':
            df = pd.read_csv(file_path, **kwargs)
        elif file_type == 'excel':
            df = pd.read_excel(file_path, **kwargs)
        elif file_type == 'parquet':
            df = pd.read_parquet(file_path, **kwargs)
        else:
            raise ValueError(f"Unsupported file type: {file_type}")
        
        logger.info(f"✓ Successfully loaded {len(df):,} rows, {len(df.columns)} columns")
        return df
        
    except pd.errors.EmptyDataError:
        logger.error("File is empty")
        raise
    except pd.errors.ParserError as e:
        logger.error(f"Parsing error: {str(e)}")
        raise
    except Exception as e:
        logger.error(f"Unexpected error: {str(e)}")
        raise
```

## Testing Strategies

### Unit Testing for Data Functions
```python
import pytest
import pandas as pd
import numpy as np

def test_calculate_revenue():
    """Test revenue calculation function."""
    # Arrange
    df = pd.DataFrame({
        'price': [10, 20, 30],
        'quantity': [2, 3, 1]
    })
    expected = pd.Series([20, 60, 30], name='revenue')
    
    # Act
    result = df['price'] * df['quantity']
    
    # Assert
    pd.testing.assert_series_equal(result, expected)

def test_data_validation_missing_columns():
    """Test validation catches missing columns."""
    df = pd.DataFrame({'col1': [1, 2, 3]})
    
    with pytest.raises(ValueError, match="Missing required columns"):
        validation = validate_dataframe(df, required_columns=['col1', 'col2'])

def test_data_cleaning_removes_nulls():
    """Test data cleaning removes null values correctly."""
    df = pd.DataFrame({
        'A': [1, 2, np.nan, 4],
        'B': [5, np.nan, 7, 8]
    })
    
    cleaned = df.dropna()
    
    assert len(cleaned) == 2
    assert cleaned.isnull().sum().sum() == 0
```

