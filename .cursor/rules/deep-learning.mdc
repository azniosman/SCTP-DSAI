## Diffusion Models

### Diffusion Pipeline Implementation

**Noise Scheduler and Sampling:**
```python
from diffusers import StableDiffusionPipeline, DDIMScheduler
import torch

def create_diffusion_pipeline(
    model_id: str = "runwayml/stable-diffusion-v1-5",
    scheduler_type: str = "ddim",
    num_inference_steps: int = 50
):
    """
    Create a diffusion pipeline with specified scheduler.
    
    Args:
        model_id: HuggingFace model identifier
        scheduler_type: Type of scheduler (ddim, pndm, euler, etc.)
        num_inference_steps: Number of diffusion steps
        
    Returns:
        Configured diffusion pipeline
    """
    if scheduler_type == "ddim":
        scheduler = DDIMScheduler.from_pretrained(
            model_id,
            subfolder="scheduler"
        )
    
    pipeline = StableDiffusionPipeline.from_pretrained(
        model_id,
        scheduler=scheduler,
        torch_dtype=torch.float16,
        safety_checker=None  # For faster inference during development
    )
    
    pipeline = pipeline.to("cuda")
    pipeline.enable_attention_slicing()  # Reduce memory usage
    
    return pipeline

def generate_images(
    pipeline,
    prompt: str,
    negative_prompt: str = "",
    num_images: int = 1,
    guidance_scale: float = 7.5,
    num_inference_steps: int = 50,
    seed: int = None
) -> list:
    """
    Generate images using the diffusion pipeline.
    
    Args:
        pipeline: Diffusion pipeline instance
        prompt: Text prompt for generation
        negative_prompt: Text to avoid in generation
        num_images: Number of images to generate
        guidance_scale: Guidance scale for classifier-free guidance
        num_inference_steps: Number of diffusion steps
        seed: Random seed for reproducibility
        
    Returns:
        List of generated PIL images
    """
    if seed is not None:
        torch.manual_seed(seed)
    
    with torch.autocast("cuda"):
        images = pipeline(
            prompt=prompt,
            negative_prompt=negative_prompt,
            num_images_per_prompt=num_images,
            guidance_scale=guidance_scale,
            num_inference_steps=num_inference_steps,
            height=512,
            width=512
        ).images
    
    return images
```

## Model Training and Evaluation

### Training Loop with Advanced Features

**Trainer Implementation:**
```python
import torch
import logging
from tqdm import tqdm
from torch.optim import AdamW
from torch.optim.lr_scheduler import CosineAnnealingLR
from typing import Dict, Optional

logger = logging.getLogger(__name__)

class ModelTrainer:
    """
    Advanced trainer with mixed precision, gradient accumulation, and checkpointing.
    """
    
    def __init__(
        self,
        model: nn.Module,
        train_dataloader,
        val_dataloader,
        learning_rate: float = 1e-4,
        num_epochs: int = 3,
        gradient_accumulation_steps: int = 1,
        max_grad_norm: float = 1.0,
        device: str = "cuda",
        use_amp: bool = True
    ):
        self.model = model
        self.train_dataloader = train_dataloader
        self.val_dataloader = val_dataloader
        self.device = device
        self.num_epochs = num_epochs
        self.gradient_accumulation_steps = gradient_accumulation_steps
        self.max_grad_norm = max_grad_norm
        self.use_amp = use_amp
        
        self.model.to(device)
        self.optimizer = AdamW(model.parameters(), lr=learning_rate)
        self.scheduler = CosineAnnealingLR(
            self.optimizer,
            T_max=len(train_dataloader) * num_epochs
        )
        self.scaler = torch.cuda.amp.GradScaler() if use_amp else None
    
    def train_epoch(self) -> float:
        """Train for one epoch with gradient accumulation."""
        self.model.train()
        total_loss = 0
        
        for step, batch in enumerate(tqdm(self.train_dataloader)):
            batch = {k: v.to(self.device) for k, v in batch.items()}
            
            # Mixed precision forward pass
            if self.use_amp:
                with torch.autocast(device_type="cuda", dtype=torch.float16):
                    outputs = self.model(**batch)
                    loss = outputs.loss / self.gradient_accumulation_steps
                
                self.scaler.scale(loss).backward()
            else:
                outputs = self.model(**batch)
                loss = outputs.loss / self.gradient_accumulation_steps
                loss.backward()
            
            total_loss += loss.item()
            
            # Gradient accumulation
            if (step + 1) % self.gradient_accumulation_steps == 0:
                if self.use_amp:
                    self.scaler.unscale_(self.optimizer)
                
                # Gradient clipping
                torch.nn.utils.clip_grad_norm_(
                    self.model.parameters(),
                    self.max_grad_norm
                )
                
                if self.use_amp:
                    self.scaler.step(self.optimizer)
                    self.scaler.update()
                else:
                    self.optimizer.step()
                
                self.optimizer.zero_grad()
                self.scheduler.step()
        
        return total_loss / len(self.train_dataloader)
    
    def validate(self) -> float:
        """Validation loop."""
        self.model.eval()
        total_loss = 0
        
        with torch.no_grad():
            for batch in tqdm(self.val_dataloader):
                batch = {k: v.to(self.device) for k, v in batch.items()}
                
                with torch.autocast(device_type="cuda", dtype=torch.float16):
                    outputs = self.model(**batch)
                    loss = outputs.loss
                
                total_loss += loss.item()
        
        return total_loss / len(self.val_dataloader)
```

### Efficient Data Loading

```python
from torch.utils.data import DataLoader, Dataset
import torch

class CustomDataset(Dataset):
    """
    Efficient dataset with proper caching and preprocessing.
    """
    
    def __init__(
        self,
        data: list,
        tokenizer,
        max_length: int = 512,
        cache_features: bool = True
    ):
        self.data = data
        self.tokenizer = tokenizer
        self.max_length = max_length
        self.cache = {} if cache_features else None
    
    def __len__(self) -> int:
        return len(self.data)
    
    def __getitem__(self, idx: int) -> dict:
        if self.cache is not None and idx in self.cache:
            return self.cache[idx]
        
        item = self.data[idx]
        
        # Tokenize with proper handling
        encodings = self.tokenizer(
            item["text"],
            max_length=self.max_length,
            padding="max_length",
            truncation=True,
            return_tensors="pt"
        )
        
        batch = {
            "input_ids": encodings["input_ids"].squeeze(),
            "attention_mask": encodings["attention_mask"].squeeze(),
            "labels": encodings["input_ids"].squeeze()
        }
        
        if self.cache is not None:
            self.cache[idx] = batch
        
        return batch

def create_dataloader(
    dataset: Dataset,
    batch_size: int = 32,
    shuffle: bool = True,
    num_workers: int = 4,
    pin_memory: bool = True
) -> DataLoader:
    """
    Create optimized DataLoader with async loading.
    
    Args:
        dataset: Dataset instance
        batch_size: Batch size
        shuffle: Whether to shuffle data
        num_workers: Number of worker processes
        pin_memory: Whether to pin memory (faster GPU transfer)
        
    Returns:
        Configured DataLoader
    """
    return DataLoader(
        dataset,
        batch_size=batch_size,
        shuffle=shuffle,
        num_workers=num_workers,
        pin_memory=pin_memory,
        drop_last=shuffle
    )
```

## Gradio Integration

### Interactive Inference Interface

```python
import gradio as gr
from typing import Tuple
import numpy as np

def create_inference_interface(
    model,
    tokenizer,
    device: str = "cuda"
) -> gr.Blocks:
    """
    Create a Gradio interface for model inference.
    
    Args:
        model: Trained model for inference
        tokenizer: Tokenizer for text processing
        device: Device to run inference on
        
    Returns:
        Gradio interface
    """
    
    def predict(text: str, max_length: int = 100) -> str:
        """
        Generate predictions from input text.
        
        Args:
            text: Input text
            max_length: Maximum output length
            
        Returns:
            Generated text
        """
        inputs = tokenizer(
            text,
            return_tensors="pt",
            truncation=True
        ).to(device)
        
        with torch.no_grad():
            outputs = model.generate(
                **inputs,
                max_length=max_length,
                num_beams=5,
                early_stopping=True
            )
        
        result = tokenizer.decode(outputs[0], skip_special_tokens=True)
        return result
    
    with gr.Blocks() as interface:
        gr.Markdown("# Model Inference Interface")
        
        with gr.Row():
            with gr.Column():
                input_text = gr.Textbox(
                    label="Input Text",
                    placeholder="Enter text here...",
                    lines=3
                )
                max_length = gr.Slider(
                    minimum=10,
                    maximum=500,
                    value=100,
                    label="Max Length"
                )
                submit_btn = gr.Button("Generate")
            
            with gr.Column():
                output_text = gr.Textbox(
                    label="Generated Output",
                    lines=3,
                    interactive=False
                )
        
        submit_btn.click(
            fn=predict,
            inputs=[input_text, max_length],
            outputs=output_text
        )
    
    return interface
```

## Error Handling and Debugging

### Comprehensive Error Handling

```python
import logging
import traceback
from typing import Callable, Any

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

def safe_forward_pass(
    model: nn.Module,
    batch: dict,
    device: str = "cuda"
) -> Tuple[torch.Tensor, bool]:
    """
    Forward pass with anomaly detection and error handling.
    
    Args:
        model: Model to run forward pass on
        batch: Input batch
        device: Device to run on
        
    Returns:
        Tuple of (output, success_flag)
    """
    try:
        # Enable anomaly detection during debugging
        torch.autograd.set_detect_anomaly(True)
        
        batch = {k: v.to(device) for k, v in batch.items()}
        
        with torch.autocast(device_type="cuda", dtype=torch.float16):
            outputs = model(**batch)
        
        # Check for NaN/Inf values
        if torch.isnan(outputs.loss) or torch.isinf(outputs.loss):
            logger.error("NaN or Inf detected in loss")
            return None, False
        
        return outputs, True
        
    except RuntimeError as e:
        logger.error(f"CUDA error: {str(e)}")
        return None, False
    except Exception as e:
        logger.error(f"Unexpected error: {str(e)}")
        logger.error(traceback.format_exc())
        return None, False
```

## Performance Optimization

### Multi-GPU Training

```python
import torch.nn as nn
from torch.nn.parallel import DataParallel, DistributedDataParallel

def setup_multi_gpu_training(
    model: nn.Module,
    distributed: bool = False
) -> nn.Module:
    """
    Setup model for multi-GPU training.
    
    Args:
        model: Model to parallelize
        distributed: Whether to use distributed data parallel
        
    Returns:
        Wrapped model
    """
    if torch.cuda.device_count() > 1:
        if distributed:
            # For distributed training
            model = DistributedDataParallel(model)
            logger.info(f"Using DistributedDataParallel with {torch.cuda.device_count()} GPUs")
        else:
            # For single-machine multi-GPU
            model = DataParallel(model)
            logger.info(f"Using DataParallel with {torch.cuda.device_count()} GPUs")
    
    return model
```

### Memory Optimization Strategies

```python
def optimize_model_memory(model: nn.Module) -> None:
    """
    Apply memory optimization techniques to model.
    
    Args:
        model: Model to optimize
    """
    # Enable gradient checkpointing if available
    if hasattr(model, "gradient_checkpointing_enable"):
        model.gradient_checkpointing_enable()
        logger.info("Gradient checkpointing enabled")
    
    # Set to eval mode for inference to save memory
    # model.eval()
    
    # Use memory efficient attention if available
    if hasattr(model, "enable_memory_efficient_attention"):
        model.enable_memory_efficient_attention()
        logger.info("Memory efficient attention enabled")

def get_model_size(model: nn.Module) -> Tuple[float, float]:
    """
    Calculate model size in MB (parameters and activations).
    
    Args:
        model: PyTorch model
        
    Returns:
        Tuple of (parameter_size_mb, trainable_param_size_mb)
    """
    total_params = sum(p.numel() for p in model.parameters())
    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)
    
    param_size = total_params * 4 / (1024 ** 2)  # 4 bytes per float32
    trainable_size = trainable_params * 4 / (1024 ** 2)
    
    return param_size, trainable_size
```

## Configuration Management

### YAML Configuration

```python
import yaml
from dataclasses import dataclass, field
from typing import Dict, Any

@dataclass
class ModelConfig:
    """Model configuration."""
    model_name: str
    hidden_size: int
    num_attention_heads: int
    num_layers: int
    dropout_rate: float = 0.1
    attention_dropout: float = 0.1
    
    @classmethod
    def from_yaml(cls, path: str) -> 'ModelConfig':
        """Load configuration from YAML file."""
        with open(path, 'r') as f:
            config_dict = yaml.safe_load(f)
        return cls(**config_dict)

@dataclass
class TrainingConfig:
    """Training configuration."""
    batch_size: int
    learning_rate: float
    num_epochs: int
    warmup_steps: int
    gradient_accumulation_steps: int = 1
    max_grad_norm: float = 1.0
    weight_decay: float = 0.01
    
    @classmethod
